@model List<BibliotecaGrpc.RatingItem>

@{
    ViewData["Title"] = "Evaluările mele";
    int readerId = ViewBag.ReaderId;
}

<h1>Evaluările mele</h1>

<form asp-action="Index" method="get" class="mb-3">
    <label for="readerId">ID cititor</label>
    <input type="number" name="readerId" id="readerId"
           value="@readerId" class="form-control" />
    <button type="submit" class="btn btn-primary mt-2">
        Afișează evaluările
    </button>
</form>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

@if (Model.Count == 0)
{
    <p>Nu există evaluări pentru acest cititor.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Carte</th>
                <th>Notă</th>
                <th>Data evaluării</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var rating in Model)
            {
                <tr>
                    <td>@rating.Title</td>
                    <td>@rating.Stars</td>
                    <td>@rating.CreatedAt.ToDateTime().ToLocalTime().ToString("dd.MM.yyyy")</td>
                </tr>
            }
        </tbody>
    </table>
}
