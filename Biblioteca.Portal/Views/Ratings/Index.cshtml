@model List<BibliotecaGrpc.RatingItem>

@{
    ViewData["Title"] = "Evaluările mele";
    int readerId = ViewBag.ReaderId;
}

<h1>Evaluările mele</h1>

<a asp-action="Create" asp-route-readerId="@readerId"
   class="btn btn-success mb-3">Adaugă evaluare</a>

<form asp-action="Index" method="get" class="mb-3">
    <label for="readerId">ID cititor</label>
    <input type="number" name="readerId" id="readerId"
           value="@readerId" class="form-control" />
    <button type="submit" class="btn btn-primary mt-2">
        Afișează evaluările
    </button>
</form>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

@if (Model.Count == 0)
{
    <p>Nu există evaluări pentru acest cititor.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Carte</th>
                <th>Notă</th>
                <th>Data evaluării</th>
                <th>Acțiuni</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var rating in Model)
            {
                <tr>
                    <td>@rating.Title</td>
                    <td>@rating.Stars</td>
                    <td>@rating.CreatedAt.ToDateTime().ToLocalTime().ToString("dd.MM.yyyy")</td>

                    <td>
                        <a asp-action="Edit"
                           asp-route-id="@rating.Id"
                           asp-route-readerId="@readerId"
                           class="btn btn-sm btn-primary">
                            Modifică
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@rating.Id"
                           asp-route-readerId="@readerId"
                           class="btn btn-sm btn-danger">
                            Șterge
                        </a>
                    </td>

                </tr>
            }
        </tbody>
    </table>
}
