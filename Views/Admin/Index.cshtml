@{
    ViewData["Title"] = "Administrare";
}

<h1>Administrare</h1>

@if (TempData["Msg"] is string msg)
{
    <div class="alert alert-info">@msg</div>
}

<p>Evaluări în baza de date: <strong>@ViewBag.Ratings</strong></p>

<form asp-controller="Admin" asp-action="ImportRatings"
      method="post" enctype="multipart/form-data" class="mb-4">
    <input type="file" name="file" accept=".csv" />
    <button type="submit" class="btn btn-primary btn-sm">
        Importă evaluări
    </button>
</form>

<hr />

<h3>Model de recomandare</h3>

<form asp-controller="Admin" asp-action="Retrain" method="post">
    <button type="submit" class="btn btn-success">
        Reantrenează modelul
    </button>
</form>
<hr />

<h3>Clasificarea genurilor literare</h3>

<form asp-controller="Admin" asp-action="TrainGenre" method="post">
    <button type="submit" class="btn btn-primary">
        Antrenează clasificatorul de genuri
    </button>
</form>