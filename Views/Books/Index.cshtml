@model IEnumerable<Intalnirea1.Models.BookListItem>

@{
    ViewData["Title"] = "Catalog cărți";
    var search = ViewData["Search"]?.ToString();
    var sort = ViewData["Sort"]?.ToString() ?? "price_desc";
}

<h1>Catalog cărți</h1>

<form asp-controller="Books" asp-action="Index" method="get" class="mb-3">
    <input type="text" name="search" value="@search"
           placeholder="Caută după titlu" />

    <select name="sort">
        <option value="price_desc" selected="@(sort == "price_desc")">Preț descrescător</option>
        <option value="price_asc" selected="@(sort == "price_asc")">Preț crescător</option>
        <option value="title_asc" selected="@(sort == "title_asc")">Titlu A–Z</option>
        <option value="title_desc" selected="@(sort == "title_desc")">Titlu Z–A</option>
    </select>

    <button type="submit" class="btn btn-primary">Caută</button>
</form>

<table class="table">
    <thead>
        <tr>
            <th>Titlu</th>
            <th>Autor</th>
            <th>Gen</th>
            <th>Preț</th>
            <th>Comenzi</th>
            <th>Acțiuni</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var book in Model)
        {
            <tr>
                <td>@book.Title</td>
                <td>@book.Author</td>
                <td>@book.Genre</td>
                <td>@book.Price</td>
                <td>@book.Orders</td>
                <td>
                    <a asp-action="Details" asp-route-id="@book.ID">Detalii</a> |
                    <a asp-action="Edit" asp-route-id="@book.ID">Editează</a> |
                    <a asp-action="Delete" asp-route-id="@book.ID">Șterge</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@{
    int currentPage = (int)(ViewData["CurrentPage"] ?? 1);
    int totalPages = (int)(ViewData["TotalPages"] ?? 0);
}

<div class="mt-3">
    <span>Pagina @currentPage din @totalPages</span>

    @if (currentPage > 1)
    {
        <a class="btn btn-outline-primary"
           asp-action="Index"
           asp-route-page="@(currentPage - 1)"
           asp-route-search="@search"
           asp-route-sort="@sort">
            Anterior
        </a>
    }

    @if (currentPage < totalPages)
    {
        <a class="btn btn-outline-primary"
           asp-action="Index"
           asp-route-page="@(currentPage + 1)"
           asp-route-search="@search"
           asp-route-sort="@sort">
            Următor
        </a>
    }
</div>
