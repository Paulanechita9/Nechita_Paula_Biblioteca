@model IEnumerable<Intalnirea1.Models.RecommendationLog>

@{
    ViewData["Title"] = "Istoricul recomandărilor";
    int page = ViewBag.Page;
    int totalPages = ViewBag.TotalPages;
    int? readerId = ViewBag.ReaderId;
}

<h1>Istoricul recomandărilor</h1>

<form method="get" asp-controller="RecommendationLogs" asp-action="Index" class="mb-3">
    <label for="readerId">ID cititor:</label>
    <input type="number" id="readerId" name="readerId"
           value="@readerId" class="form-control" style="max-width:200px" />
    <button type="submit" class="btn btn-primary mt-2">Filtrează</button>
    <a asp-action="Index" class="btn btn-secondary mt-2">Toate</a>
</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Cititor</th>
            <th>Carte</th>
            <th>Scor</th>
            <th>Data recomandării</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ReaderId</td>
                <td>@item.Book?.Title</td>
                <td>@item.Score.ToString("F2")</td>
                <td>@item.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <p>Nu există recomandări înregistrate.</p>
}

@if (totalPages > 1)
{
    <nav>
        @for (int i = 1; i <= totalPages; i++)
        {
            <a asp-action="Index"
               asp-route-page="@i"
               asp-route-readerId="@readerId"
               class="btn @(i == page ? "btn-primary" : "btn-outline-primary")">
                @i
            </a>
        }
    </nav>
}
